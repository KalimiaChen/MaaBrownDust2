from maa.agent.agent_server import AgentServer
from maa.custom_recognition import CustomRecognition
from maa.context import Context

@AgentServer.custom_recognition("material_selector")
class MaterialSelectorRecognition(CustomRecognition):
    def analyze(
        self,
        context: Context,
        argv: CustomRecognition.AnalyzeArg,
    ) -> CustomRecognition.AnalyzeResult:
        print("开始检测材料数量...")
        
        # 检测五种材料的数量
        fire_count = self._detect_fire_material(context, argv.image)
        water_count = self._detect_water_material(context, argv.image)
        wind_count = self._detect_wind_material(context, argv.image)
        light_count = self._detect_light_material(context, argv.image)
        dark_count = self._detect_dark_material(context, argv.image)
        
        print(f"检测结果 - 火: {fire_count}, 水: {water_count}, 风: {wind_count},光: {light_count}, 暗: {dark_count}, ")
        
        # 选择数量最少的材料
        if fire_count <= water_count and fire_count <= wind_count and fire_count <= light_count and fire_count <= dark_count:
            next_task = "快速狩猎_圣石洞穴_火材料选择"
            print("选择火材料（数量最少）")
        elif water_count <= fire_count  and water_count <= wind_count and water_count <= light_count and water_count <= dark_count:
            next_task = "快速狩猎_圣石洞穴_水材料选择" 
            print("选择水材料（数量最少）")
        elif wind_count <= fire_count  and wind_count <= water_count and wind_count <= light_count and wind_count <= dark_count:
            next_task = "快速狩猎_圣石洞穴_风材料选择" 
            print("选择风材料（数量最少）")
        elif light_count <= fire_count  and light_count <= water_count and light_count <= wind_count and light_count <= dark_count:
            next_task = "快速狩猎_圣石洞穴_光材料选择" 
            print("选择光材料（数量最少）")
        else:
            next_task = "快速狩猎_圣石洞穴_暗材料选择"
            print("选择暗材料（数量最少）")
        
        # 动态设置下一步任务
        context.override_next(argv.node_name, [next_task])
        
        return CustomRecognition.AnalyzeResult(
            box=(0, 0, 0, 0), detail=f"选择{next_task}"
        )
    
    def _detect_fire_material(self, context, image):
        """检测火材料数量"""
        try:
            # 使用OCR识别火材料数量区域
            result = context.run_recognition(
                "OCR",
                image,
                pipeline_override={
                    "OCR": {
                        "roi": [1120,55,73,23],  # 需要根据实际界面调整
                        "expected": [r"\d+"],
                        "threshold": 0.7
                    }
                }
            )
            count = int(result.detail) if result.detail.isdigit() else 999
            print(f"火材料数量: {count}")
            return count
        except Exception as e:
            print(f"火材料识别失败: {e}")
            return 999
    
    def _detect_water_material(self, context, image):
        """检测水材料数量"""
        try:
            # 使用OCR识别水材料数量区域
            result = context.run_recognition(
                "OCR", 
                image,
                pipeline_override={
                    "OCR": {
                        "roi": [1120,83,73,23],  # 需要根据实际界面调整
                        "expected": [r"\d+"],
                        "threshold": 0.7
                    }
                }
            )
            count = int(result.detail) if result.detail.isdigit() else 999
            print(f"水材料数量: {count}")
            return count
        except Exception as e:
            print(f"水材料识别失败: {e}")
            return 999
    
    def _detect_wind_material(self, context, image):
        """检测风材料数量"""
        try:
            # 使用OCR识别风材料数量区域
            result = context.run_recognition(
                "OCR",
                image,
                pipeline_override={
                    "OCR": {
                        "roi": [1120,111,73,23],  # 需要根据实际界面调整
                        "expected": [r"\d+"],
                        "threshold": 0.7
                    }
                }
            )
            count = int(result.detail) if result.detail.isdigit() else 999
            print(f"风材料数量: {count}")
            return count
        except Exception as e:
            print(f"风材料识别失败: {e}")
            return 999
        
    def _detect_light_material(self, context, image):
        """检测光材料数量"""
        try:
            # 使用OCR识别光材料数量区域
            result = context.run_recognition(
                "OCR",
                image,
                pipeline_override={
                    "OCR": {
                        "roi": [1120,139,73,23],  # 需要根据实际界面调整
                        "expected": [r"\d+"],
                        "threshold": 0.7
                    }
                }
            )
            count = int(result.detail) if result.detail.isdigit() else 999
            print(f"光材料数量: {count}")
            return count
        except Exception as e:
            print(f"光材料识别失败: {e}")
            return 999

    def _detect_dark_material(self, context, image):
        """检测暗材料数量"""
        try:
            # 使用OCR识别暗材料数量区域
            result = context.run_recognition(
                "OCR",
                image,
                pipeline_override={
                    "OCR": {
                        "roi": [1120,167,73,23],  # 需要根据实际界面调整
                        "expected": [r"\d+"],
                        "threshold": 0.7
                    }
                }
            )
            count = int(result.detail) if result.detail.isdigit() else 999
            print(f"暗材料数量: {count}")
            return count
        except Exception as e:
            print(f"暗材料识别失败: {e}")
            return 999
    